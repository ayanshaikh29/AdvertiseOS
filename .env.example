# ---- Supabase (server-side only service key; never expose to client) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# ---- Gemini LLM engine (server-side only; LLM_PROVIDER=gemini|fake) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model names live in config (explicit model IDs pinned for reproducibility;
# overridable via environment variables). Prices come from src/lib/llm/pricing.ts or LLM_PRICES_JSON.
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_MODEL_EMBED=text-embedding-004
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
GEMINI_EMBED_DIMS=768
GEMINI_CONTEXT_CACHE=true
# Optional JSON override of the price table (see src/lib/llm/pricing.ts)
LLM_PRICES_JSON=

# ---- Inngest ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
APPROVALS_FROM_EMAIL=
MONTHLY_COST_LIMIT_USD=50

# ---- Image provider (template = deterministic SVG composite) ----
IMAGE_PROVIDER=template

# ---- Connector framework (Phase 6) ----
# Sample connectors labeled "Sample data" everywhere. Set false to require real credentials.
FEATURE_FAKE_CONNECTORS=true
# AES-256-GCM key for connector tokens (64 hex chars = 32 bytes): openssl rand -hex 32
CONNECTOR_TOKEN_KEY=
# Real connectors land in Phase 6B behind these flags (see docs/INTEGRATIONS.md)
FEATURE_META_CONNECTOR=false
FEATURE_WHATSAPP_CONNECTOR=false
FEATURE_GOOGLE_CONNECTOR=false
FEATURE_WEBSITE_CONNECTOR=false

# ---- Feature flags ----
FEATURE_META_PUBLISH=false

# External cron secret for POST /api/autopilot/tick (x-cron-secret header)
# CRON_SECRET=change-me
# FEATURE_AUTOPILOT=false  # disables the Run autopilot week action
advos_mcp_3d5ef2a1481d98f39b6a48891e7a322ca5aad664d9f27b9e437180bc45983a40